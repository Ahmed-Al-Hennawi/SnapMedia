# Copy values into your hosting provider's environment settings.
# Choose your final HTTPS origin before publishing (no path or trailing slash).
# Replace with the real domain before enabling this setting.
# SNAPMEDIA_SITE_URL=https://your-domain.example

# Set this only when a trusted HTTPS reverse proxy sets forwarding headers.
# Use the exact number of trusted proxy hops; otherwise leave at 0.
SNAPMEDIA_TRUSTED_PROXY_COUNT=0

# Optional resource limits (defaults shown).
SNAPMEDIA_MAX_DURATION=1800
SNAPMEDIA_MAX_MB=300
